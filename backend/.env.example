# =============================================
# Чистовик — Конфигурация бэкенда
# =============================================
# Скопируйте этот файл в .env и заполните значения

# Сервер
HOST=0.0.0.0
PORT=8080

# База данных (PostgreSQL)
DATABASE_URL=postgres://chistovik:password@localhost:5432/chistovik
DATABASE_MAX_CONNECTIONS=20

# Redis (для rate limiting и кэширования)
REDIS_URL=redis://127.0.0.1:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION_HOURS=72

# Media Token Secret (НЕ используйте хардкод!)
# Минимум 32 символа, генерируйте через: openssl rand -hex 32
MEDIA_TOKEN_SECRET=your-media-token-secret-min-32-chars-change-this

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://chistovik.ru

# S3-хранилище (Yandex Cloud / Selectel / MinIO)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=chistovik-media
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_REGION=ru-central1

# ЮKassa (платежи)
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
# Webhook secret для HMAC-верификации
YOOKASSA_WEBHOOK_SECRET=your-webhook-hmac-secret

# Комиссия платформы (%)
PLATFORM_COMMISSION_PERCENT=8.0

# Тизеры
TEASER_AUDIO_SECONDS=15
TEASER_VIDEO_SECONDS=60

# Сессии
MAX_SESSIONS_PER_USER=2
TOKEN_EXPIRATION_MINUTES=120

# Rate limiting
RATE_LIMIT_API=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_MEDIA=30

# Безопасность
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# SMTP (email-уведомления)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@chistovik.ru
SMTP_PASSWORD=your-smtp-password

# FFmpeg (для водяных знаков и транскодирования)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Telemetry (OpenTelemetry)
OTLP_ENDPOINT=http://localhost:4317
METRICS_ENABLED=true

# Логирование
RUST_LOG=info,sqlx=warn,actix_web=info
